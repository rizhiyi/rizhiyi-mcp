# Python MCP skeleton configuration
# LOGEASE_BASE_URL=http://127.0.0.1:8090

# 认证配置（三选一）：
#   方式 A（推荐）：显式分离 username 和 apikey secret，支持中文 username
#   LOGEASE_USERNAME= 张三
#   LOGEASE_API_KEY=ZHANGSAN_API_SECRET
#
#   方式 B：apikey 包含 username:secret，服务器自动拆分
#   LOGEASE_API_KEY=admin:xxxx
#
#   方式 C：完整 Authorization header，支持 apikey 和 Basic 两种格式
#   LOGEASE_AUTH_HEADER=apikey YOUR_API_SECRET
#   LOGEASE_AUTH_HEADER=basic BASE64_YOUR_NAME_PASS  （base64 编码后的 user:password）

# LOGEASE_TLS_REJECT_UNAUTHORIZED=false

# HTTP gateway settings
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3000
# MCP_HTTP_BASE_PATH=/mcp

# Shared result store settings
# LOG_TOOLS_RESULT_STORE_DIR=/tmp/rizhiyi-mcp/log-tool-results
# LOG_TOOLS_RESULT_TTL_SECONDS=1800
# LOG_TOOLS_RESULT_INLINE_MAX_BYTES=24576
# LOG_TOOLS_RESULT_MAX_FILE_BYTES=5242880

# ==============================================================
# OAuth2 Bearer 认证（默认关闭，统一 SSO 场景下启用）
# 智能体平台把 OAuth access_token 通过 Authorization: Bearer <token> 传入 MCP，
# MCP 依次执行：验证 token -> token exchange -> 调日志易 login 获取 JWT -> 调用 API
# 本地开发可使用本仓库自带 mock OAuth server：python -m rizhiyi_mcp.oauth_dev_server
# ==============================================================
# OAUTH_ENABLE=false
# OAUTH_ISSUER=http://127.0.0.1:4444
# OAUTH_CLIENT_ID=rizhiyi-mcp-dev
# OAUTH_CLIENT_SECRET=dev-secret
# OAUTH_INTROSPECT_ENDPOINT=          # 可选，手动覆盖 well-known 自动发现
# OAUTH_TOKEN_ENDPOINT=              # 可选，手动覆盖 well-known 自动发现
# OAUTH_TOKEN_EXCHANGE_AUDIENCE=logease  # RFC 8693 token exchange 的 audience
# OAUTH_SKIP_EXCHANGE=false          # 认证中心不支持 RFC 8693 时设为 true（跳过 exchange 直接用原 token 调 login）
# OAUTH_JWT_REFRESH_AHEAD_SECONDS=60 # JWT 过期前多少秒开始自动续期

# 日志易登录接口（不同版本路径/字段可能不同，可配置）
# LOGEASE_LOGIN_ENDPOINT=/api/v3/login/token/verify/
# LOGEASE_LOGIN_TOKEN_FIELD=token    # 发给日志易登录接口时，exchange token 放到哪个 JSON 字段
