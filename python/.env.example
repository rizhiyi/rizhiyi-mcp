# Python MCP skeleton configuration
# 日志易 5.2 版本之后，内部模块通信默认开启 SSL 加密
# LOGEASE_BASE_URL=https://127.0.0.1:8090

# 认证配置（三选一）：
#   方式 A（推荐）：显式分离 username 和 apikey secret，支持中文 username
#   LOGEASE_USERNAME= 张三
#   LOGEASE_API_KEY=ZHANGSAN_API_SECRET
#
#   方式 B：apikey 包含 username:secret，服务器自动拆分
#   LOGEASE_API_KEY=admin:xxxx
#
#   方式 C：完整 Authorization header，支持 apikey 和 Basic 两种格式
#   LOGEASE_AUTH_HEADER=apikey YOUR_API_SECRET
#   LOGEASE_AUTH_HEADER=basic BASE64_YOUR_NAME_PASS  （base64 编码后的 user:password）

# LOGEASE_TLS_REJECT_UNAUTHORIZED=false

# HTTP gateway settings
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3000
# MCP_HTTP_BASE_PATH=/mcp

# MCP tool usage audit log (HTTP gateway; JSON Lines)
# RIZHIYI_LOG_DIR=./logs
# RIZHIYI_LOG_NAME_PREFIX=mcp-server
# RIZHIYI_LOG_ROTATE_BYTES=10485760
# RIZHIYI_LOG_ROTATE_INTERVAL=1d
# RIZHIYI_LOG_KEEP_FILES=7

# DNS rebinding protection（MCP SDK TransportSecuritySettings）
# 默认关闭（MCP 网关已有 Authorization 鉴权，无需额外防御）；
# 生产环境如需开启，同时配置 MCP_ALLOWED_HOSTS / MCP_ALLOWED_ORIGINS
# 注意：allowed_hosts 只支持精确匹配和 host:* 通配端口，不支持 "*" 全通配
# MCP_ENABLE_DNS_REBINDING_PROTECTION=false
# MCP_ALLOWED_HOSTS=["*"]
# MCP_ALLOWED_ORIGINS=["*"]

# Tool-call rate limiting (optional; fixed one-minute windows, disabled by default)
# 全部 MCP 工具调用合计上限
# MCP_RATE_LIMIT_GLOBAL_PER_MINUTE=600
# 单工具上限；可用 tool_name，或 server/tool_name 做精确匹配
# MCP_RATE_LIMIT_PER_TOOL={"log_search_sheet":120,"dashboard/create_dashboard_from_spec":10}

# Shared result store settings
# LOG_TOOLS_RESULT_STORE_DIR=/tmp/rizhiyi-mcp/log-tool-results
# LOG_TOOLS_RESULT_TTL_SECONDS=1800
# LOG_TOOLS_RESULT_INLINE_MAX_BYTES=24576
# LOG_TOOLS_RESULT_MAX_FILE_BYTES=5242880

# Query guardrails (SPL 执行护栏：拒绝 / 评分 / 时间范围 / 脱敏，默认关闭)
# 详见 docs/research-spl-guardrails-risky-commands.md §7 环境变量设计；TS/Python 双端配置一致
# MCP_GUARDRAILS_ENABLED=false
# MCP_GUARDRAIL_ENFORCE_MODE=audit          # enforce=拦截 / audit=只提示+审计
# MCP_GUARDRAIL_DENY_COMMANDS=["collect","delete","mcollect","fit","outputlookup","download","save","dbxoutput","lookup2","fromes","fromkafkapy","rest","dbxlookup","dbxquery","dbxexec","ldapsearch","ldapfilter","ldapgroup","ldapfetch","history"]
# MCP_GUARDRAIL_RISK_ALERT_THRESHOLD=50
# MCP_GUARDRAIL_RISK_REJECT_THRESHOLD=100
# MCP_GUARDRAIL_RISK_RULE_OVERRIDES={}
# 示例：提高 delete 分值、关闭 append 评分、降低超时间窗分值
# MCP_GUARDRAIL_RISK_RULE_OVERRIDES={"delete":100,"append":0,"time_range_exceeds":10}
# MCP_GUARDRAIL_SAFE_TIMERANGE=24h
# MCP_GUARDRAIL_EXEC_TIMEOUT_SECONDS=60
# MCP_GUARDRAIL_MAX_EVENTS=1000
# MCP_GUARDRAIL_SANITIZE_ENABLED=true
# MCP_GUARDRAIL_SANITIZE_MASKS=["credit_card","ssn"]
# MCP_GUARDRAIL_SANITIZE_CUSTOM_PATTERNS=[]
# 示例：掩码中国大陆手机号，并把 access_token 参数值替换为 ***
# MCP_GUARDRAIL_SANITIZE_CUSTOM_PATTERNS=[{"pattern":"(?<!\\d)1[3-9]\\d{9}(?!\\d)","replacement":"138****0000"},{"pattern":"(?i)(access_token[=:]\\s*)[^&\\s]+","replacement":"\\g<1>***"}]
