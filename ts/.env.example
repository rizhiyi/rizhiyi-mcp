# LogEase MCP server configuration
# LOGEASE_BASE_URL=http://127.0.0.1:8090

# 认证配置（三选一）：
#   方式 A（推荐）：显式分离 username 和 apikey secret，支持中文 username
#   LOGEASE_USERNAME=张三
#   LOGEASE_API_KEY=ZHANGSAN_API_SECRET
#
#   方式 B：apikey 包含 username:secret，服务器自动拆分
#   LOGEASE_API_KEY=admin:xxxx
#
#   方式 C：完整 Authorization header，支持 apikey 和 Basic 两种格式
#   LOGEASE_AUTH_HEADER=apikey YOUR_API_SECRET
#   LOGEASE_AUTH_HEADER=basic BASE64_YOUR_NAME_PASS  （base64 编码后的 user:password）

# TLS settings (optional)
# Set to "true" to enforce strict certificate validation
# Default is "false" to match current development behavior
# LOGEASE_TLS_REJECT_UNAUTHORIZED=false

# HTTP gateway (Streamable HTTP) settings
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3000
# MCP_HTTP_BASE_PATH=/mcp

# Shared result store (large payloads -> MCP resources)
# LOG_TOOLS_RESULT_STORE_DIR=/tmp/rizhiyi-mcp/log-tool-results
# LOG_TOOLS_RESULT_TTL_SECONDS=1800
# LOG_TOOLS_RESULT_INLINE_MAX_BYTES=24576
# LOG_TOOLS_RESULT_MAX_FILE_BYTES=5242880

# ----------------------------------------------------------------------
# OAuth2 / 统一 SSO（可选，本地开发建议配合 mock OAuth server 使用）
#
# 链路：客户端（智能体平台）→ 带 Bearer <OAuth access_token> 调 MCP
#         → MCP OAuthClient（introspect RFC7662 + token-exchange RFC8693 audience=logease）
#         → 通过日志易 login 端点换取日志易原生 JWT
#         → 后续所有 API 调用都携带该原生 JWT Authorization header。
#
# 本地开发启动 mock OAuth server：
#   cd python && .venv/bin/python -m rizhiyi_mcp.oauth_dev_server \
#       --host 127.0.0.1 --port 4444 --issuer http://127.0.0.1:4444
# 然后配置下面的变量（client_id 默认 rizhiyi-mcp-dev / client_secret 默认 dev-secret，
# password grant 用户名任意，密码随便填即可）。
# ----------------------------------------------------------------------
# OAUTH_ENABLE=false
# OAUTH_ISSUER=http://127.0.0.1:4444
# OAUTH_CLIENT_ID=rizhiyi-mcp-dev
# OAUTH_CLIENT_SECRET=dev-secret
# （可选，省略时通过 /.well-known/oauth-authorization-server 自动发现）
# OAUTH_INTROSPECT_ENDPOINT=http://127.0.0.1:4444/introspect
# OAUTH_TOKEN_ENDPOINT=http://127.0.0.1:4444/token
# （可选，token-exchange 目标 audience；默认 logease）
# OAUTH_TOKEN_EXCHANGE_AUDIENCE=logease
# （降级开关：若认证中心不支持 RFC 8693 token exchange，设为 true，跳过 exchange 网络调用）
# OAUTH_SKIP_EXCHANGE=false
# （提前刷新窗口：JWT 到期前多少秒开始尝试 refresh/login，默认 60s）
# OAUTH_JWT_REFRESH_AHEAD_SECONDS=60
#
# 日志易 JWT 登录端点：
#   开发环境可以设为 mock server 的绝对 URL：http://127.0.0.1:4444/mock/logease-login
#   生产环境通常为相对路径 /api/v3/login/token/verify/ （或业务实际端点）
# LOGEASE_LOGIN_ENDPOINT=http://127.0.0.1:4444/mock/logease-login
# （登录端点接收 exchange 后 token 的字段名，默认 "token"，其它常见 "access_token"/"exchange_token"）
# LOGEASE_LOGIN_TOKEN_FIELD=token

