{
  "mcpServers": {
    "rizhiyi_search": {
      "command": "node",
      "args": ["/CHANGE/ME/rizhiyi-mcp/ts/dist/log-tools-server.js"],
      "env": {
        "LOGEASE_BASE_URL": "http://<LOGEASE_BASE_URL>",
        "LOGEASE_API_KEY": "<USERNAME>:<API_KEY>",
        "MCP_GUARDRAILS_ENABLED": "true",
        "MCP_GUARDRAIL_ENFORCE_MODE": "audit",
        "MCP_GUARDRAIL_RISK_ALERT_THRESHOLD": "50",
        "MCP_GUARDRAIL_RISK_REJECT_THRESHOLD": "100",
        "MCP_GUARDRAIL_SAFE_TIMERANGE": "24h",
        "MCP_GUARDRAIL_EXEC_TIMEOUT_SECONDS": "60",
        "MCP_GUARDRAIL_MAX_EVENTS": "1000"
      }
    },
    "rizhiyi_chatspl": {
      "command": "node",
      "args": ["/CHANGE/ME/rizhiyi-mcp/ts/dist/chatspl-server.js"],
      "env": {
        "LOGEASE_BASE_URL": "http://<LOGEASE_BASE_URL>",
        "LOGEASE_API_KEY": "<USERNAME>:<API_KEY>",
        "MCP_GUARDRAILS_ENABLED": "true",
        "MCP_GUARDRAIL_ENFORCE_MODE": "audit",
        "MCP_GUARDRAIL_RISK_ALERT_THRESHOLD": "50",
        "MCP_GUARDRAIL_RISK_REJECT_THRESHOLD": "100",
        "MCP_GUARDRAIL_SAFE_TIMERANGE": "24h",
        "MCP_GUARDRAIL_EXEC_TIMEOUT_SECONDS": "60",
        "MCP_GUARDRAIL_MAX_EVENTS": "1000"
      }
    },
    "rizhiyi_dashboard": {
      "command": "node",
      "args": ["/CHANGE/ME/rizhiyi-mcp/ts/dist/dashboard-server.js"],
      "env": {
        "LOGEASE_BASE_URL": "http://<LOGEASE_BASE_URL>",
        "LOGEASE_API_KEY": "<USERNAME>:<API_KEY>",
        "MCP_GUARDRAILS_ENABLED": "true",
        "MCP_GUARDRAIL_ENFORCE_MODE": "audit",
        "MCP_GUARDRAIL_RISK_ALERT_THRESHOLD": "50",
        "MCP_GUARDRAIL_RISK_REJECT_THRESHOLD": "100",
        "MCP_GUARDRAIL_SAFE_TIMERANGE": "24h",
        "MCP_GUARDRAIL_EXEC_TIMEOUT_SECONDS": "60",
        "MCP_GUARDRAIL_MAX_EVENTS": "1000"
      }
    },
    "rizhiyi_parserrule": {
      "command": "node",
      "args": ["/CHANGE/ME/rizhiyi-mcp/ts/dist/parserrule-server.js"],
      "env": {
        "LOGEASE_BASE_URL": "http://<LOGEASE_BASE_URL>",
        "LOGEASE_API_KEY": "<USERNAME>:<API_KEY>"
      }
    },
    "rizhiyi_dynamic_field": {
      "command": "node",
      "args": ["/CHANGE/ME/rizhiyi-mcp/ts/dist/fieldconfig-server.js"],
      "env": {
        "LOGEASE_BASE_URL": "http://<LOGEASE_BASE_URL>",
        "LOGEASE_API_KEY": "<USERNAME>:<API_KEY>"
      }
    },
    "rizhiyi_ingest": {
      "command": "node",
      "args": ["/CHANGE/ME/rizhiyi-mcp/ts/dist/ingest-server.js"],
      "env": {
        "LOGEASE_BASE_URL": "http://<LOGEASE_BASE_URL>",
        "LOGEASE_API_KEY": "<USERNAME>:<API_KEY>"
      }
    },
    "rizhiyi_alert": {
      "command": "node",
      "args": ["/CHANGE/ME/rizhiyi-mcp/ts/dist/alert-server.js"],
      "env": {
        "LOGEASE_BASE_URL": "http://<LOGEASE_BASE_URL>",
        "LOGEASE_API_KEY": "<USERNAME>:<API_KEY>",
        "MCP_GUARDRAILS_ENABLED": "true",
        "MCP_GUARDRAIL_ENFORCE_MODE": "enforce",
        "MCP_GUARDRAIL_RISK_ALERT_THRESHOLD": "50",
        "MCP_GUARDRAIL_RISK_REJECT_THRESHOLD": "100",
        "MCP_GUARDRAIL_SAFE_TIMERANGE": "24h",
        "MCP_GUARDRAIL_EXEC_TIMEOUT_SECONDS": "60",
        "MCP_GUARDRAIL_MAX_EVENTS": "1000"
      }
    },
    "rizhiyi_manage": {
      "command": "node",
      "args": ["/CHANGE/ME/rizhiyi-mcp/ts/dist/manage-server.js"],
      "env": {
        "LOGEASE_BASE_URL": "http://<LOGEASE_BASE_URL>",
        "LOGEASE_API_KEY": "<USERNAME>:<API_KEY>"
      }
    }
  }
}
